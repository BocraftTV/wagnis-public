{
  "name": "@wagnis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx --conditions=wagnis-source --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.5",
    "@fastify/websocket": "11.3.3",
    "@wagnis/engine": "0.0.0",
    "@wagnis/shared": "0.0.0",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/ws": "8.18.2",
    "ws": "8.22.0"
  }
}
