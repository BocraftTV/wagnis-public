# Copy to .env (never commit it) and fill in. Loaded via `node --env-file`.
PORT=3000
# Required, at least 8 characters. Needed to create rooms.
WAGNIS_CREATE_CODE=
WAGNIS_DB_PATH=./data/wagnis.db
# Optional: header carrying the real client IP behind a proxy, e.g. cf-connecting-ip
TRUST_PROXY_HEADER=
# Optional: address other devices use to reach this server; the lobby QR code points to it (plus /r/<room code>).
# Origin only: http(s), host, optional port; no path, credentials, query or fragment. Not a secret, but keep your real address out of the repo.
# WAGNIS_PUBLIC_URL=http://<server-ip>:3000
