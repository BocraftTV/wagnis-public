{
  "name": "@wagnis/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "wagnis-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./map-data": {
      "wagnis-source": "./src/map-data.ts",
